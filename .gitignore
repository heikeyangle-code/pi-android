# Build output
build/
.gradle/
.kotlin/
local.properties

# Downloaded upstream artifacts (pinned in runtime.lock.json). Never committed:
# ~65 MB of third-party binaries, reproducibly re-fetched by tools/fetch-runtime.mjs.
build/downloads/

# Runtime payloads assembled into the app. Produced by tools/fetch-runtime.mjs;
# regenerated rather than versioned so the repo stays small and every byte is
# traceable to a pinned upstream hash.
app/src/main/assets/runtime/
app/src/main/jniLibs/

# The digest of those payloads, written beside them by the same script and read at
# boot by RuntimeProvisioner.packagedRevision. Ignored for a stronger reason than
# the payloads themselves: a committed digest would be a *lie* the moment anyone
# built with different payloads, and a stale revision is exactly the failure this
# file exists to prevent — every device would keep the tree it already unpacked.
app/src/main/assets/runtime-revision.txt

# Each payload's own digest and owned-path list (2.2 MB), written by the same script
# and read at boot by RuntimeProvisioner to decide *which* payload changed. Same
# reason as the revision above: a committed copy is a statement about payloads that
# whoever builds may not have, and it is regenerated by `node tools/fetch-runtime.mjs`,
# which CI runs immediately before `:app:assembleRelease`. It was simply never added
# here when the per-payload state landed (2026-09-19), so it showed up untracked in
# every working tree.
app/src/main/assets/runtime-payloads/

# Python bytecode. `tools/build-license-assets.py` is imported (not only executed) by
# some local harnesses, which leaves a `tools/__pycache__/` behind — nobody builds from
# it, and it showed up untracked until this line existed.
__pycache__/
*.pyc

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
