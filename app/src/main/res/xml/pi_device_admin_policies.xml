<?xml version="1.0" encoding="utf-8"?>
<!--
  设备管理员策略声明。这里只列 DeviceAdmin.kt 真的会调用的两条：

    disable-camera              → DeviceAdmin.setCameraDisabled
    disable-keyguard-features   → DeviceAdmin.setKeyguardDisabled

  其余动作（应用隐藏/挂起、阻止卸载、CA 证书、常驻 VPN、Lock Task、系统更新策略、
  权限授予状态、状态栏、重启、擦除）在 Device Owner / Profile Owner 身份下不需要、
  也没有对应的 uses-policy 标记；而普通设备管理员身份本来就用不到它们（DeviceAdmin
  的前置检查会拒绝）。最小声明让系统弹出的激活页面只要求我们确实要用的东西。
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
