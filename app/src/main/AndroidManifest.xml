<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The agent talks to LLM providers over the network. No inbound ports. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Long turns must survive the screen going off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      投屏（MediaProjection）。

      权限与服务类型是**同一件事的两半**，缺一半系统就拒绝：Android 10 起，
      `getMediaProjection` 之前 App 必须有一个 `foregroundServiceType="mediaProjection"`
      的前台服务在跑；Android 14+ 把它变成了硬校验，没有就直接失败
      （`PiScreenCapture.attach` 的失败文案里写着这一条）。所以这条权限在本文件里
      与下面 PiCaptureService 的 `mediaProjection` 类型成对出现 —— 只加一半等于没加。

      与 CAMERA 一样，这是一条普通权限，没有运行时弹窗：真正的「用户同意」是
      系统投屏授权对话框那一次（`PiScreenCapture.consentIntent` → RESULT_OK）。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Device capability bridge. None of these are needed until the user turns on
      the matching capability group in 设置 → 设备能力 (docs/pi-android-app-design.md
      §21.4), and each one is requested with a reason naming this exact line when
      it is missing — never silently.
        VIBRATE                    → android_vibrate
        KILL_BACKGROUND_PROCESSES  → android_stop_app
        ACCESS_*_LOCATION          → android_device_state(what="location") (runtime request)
        CAMERA                     → android_torch (runtime request). Since API 23
                                     `CameraManager.setTorchMode` requires it; without
                                     it some ROMs fail with a message that reads like
                                     "no flash on this device", which is why the
                                     missing grant is now reported as NO_PERMISSION.
        QUERY_ALL_PACKAGES         → keeps android_app(action="list") complete on API 30+, where
                                     package visibility is filtered by default
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Declaring CAMERA would otherwise imply `android.hardware.camera` (and
      autofocus) as *required* features, which filters the app off devices without
      a camera in any store listing. This app only ever points the flash at
      `setTorchMode`, so all three are optional.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!--
      The pre-scoped-storage path, and only there.

      `minSdk 26` means Android 8/9 are supported, where writing the public
      Download folder needs WRITE_EXTERNAL_STORAGE and reading another app's file
      there needs READ_EXTERNAL_STORAGE. Both are declared with `maxSdkVersion` so
      they are requestable exactly where they still mean anything: on API 29+ the
      app uses MediaStore, and from API 30 onwards the OS ignores
      WRITE_EXTERNAL_STORAGE anyway. Before this, the code told the user to "let the
      maintainer add the permission to the manifest" — i.e. android_download(op="write") could not
      work at all on the API levels this app claims to support.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      「从设备目录选择」——把一个设备上的真目录当作工作区。

      工作区必须是**真实文件路径**：`PiEngineHost.bootLocked` 把
      `workspace.absolutePath` 绑进 guest 并把它当作引擎的 cwd
      （`PiEngineHost.kt:407`、`:451`），而 proot/proroot 的绑定点只吃真路径。
      SAF 给的是 `content://` 树 URI，能经 `/app/saf/*` 读写，但**不能当工作区根** ——
      所以这里要的是「所有文件访问」，不是文档选择器。

      No `maxSdkVersion`: on API 30+ this is the only way to reach an arbitrary real
      directory, and below 30 the OS simply ignores it (the classic
      WRITE/READ_EXTERNAL_STORAGE pair above is what works there — the runtime check
      in `WorkspaceExternalPicker` asks for those on old versions and for this one on
      API 30+, never the old pair on a modern device, where it is meaningless).

      `tools:ignore="ScopedStorage"` is the lint id for this permission: the app uses
      it for exactly the documented exception (a user-picked directory that a
      container has to bind-mount), not for broad file browsing for its own sake.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Package visibility for the manager app, so the status card can say
         「未安装」 instead of 「未运行」. -->
    <queries>
        <package android:name="moe.shizuku.manager" />
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      明文 HTTP **全局**放行（用户拍板：「明文开」）。

      为什么需要：渲染层现在真的会去取 markdown 里的 `http(s)` 图片
      （`bridge/GuestImageBytes.kt` 的 `fromRemote`），而 `app/build.gradle.kts` 的
      `targetSdk` 默认是 28（那个文件顶部写着理由）—— API 28 起平台默认拒绝明文，于是
      `http://` 的图片一律在取字节那一步失败，报出来的是
      `IOException: Cleartext HTTP traffic not permitted`，只有 `https://` 能用。

      范围要说清楚，这一条不是「只放行图片」：`usesCleartextTraffic` 是**整个应用进程**的
      网络策略开关，Java 网络栈（`HttpURLConnection`/OkHttp）与 `WebView` 的资源加载一起
      放开，本进程任何一次出站请求都可以走 `http://`。想收窄只能换成 network security
      config 的按域名白名单，而那要求事先知道用户会贴哪些图片站 —— 做不到，所以这里如实
      开全局，而不是把范围写得比实际小。
    -->
    <application
        android:name=".PiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pi"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!--
          Shizuku (dev.rikka.shizuku:provider) delivers the ADB-level binder to this
          app through this provider. Without it the binder never arrives, so
          ShizukuShellBackend would report 「未运行」 even while Shizuku is running.

          A provider is only legal *inside* application. Declared one level up, AAPT
          fails the release build with "unexpected element provider found in
          manifest" (CI run b1945fd, APK job, step 9 "Assemble arm64 release APK").

          `android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"` is what
          the Shizuku-API README specifies for the declaration: it keeps ordinary apps
          from calling the provider, so only the platform (and therefore Shizuku) can.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          「用其他应用打开」：把一个工作区文件以 `content://` URI + 读权限交给系统里的应用
          （`WorkspaceViewer.openWithOtherApp`）。

          为什么必须有 provider：这些文件在应用私有目录里（`<files>/pi/runtime/rootfs/…`），
          别的应用读不到；而 `file://` 从 Android 7 起交给另一个应用会抛
          `FileUriExposedException`。唯一的通道就是 FileProvider 的 URI +
          `FLAG_GRANT_READ_URI_PERMISSION`。

          路径范围见 `res/xml/file_paths.xml`：**只有 `<files>/pi/` 这一棵**。
          `exported="false"` 挡住外面直接查询它；`grantUriPermissions="true"` 是必须的，
          否则连我们自己的显式授权也传不出去 —— 授权仍然是一次一个 URI 的，不是开放整棵树。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps a running turn alive while the app is backgrounded. -->
        <service
            android:name=".service.PiEngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a local AI coding agent (pi) whose tool calls can exceed the dataSync time limit" />
        </service>

        <!--
          Device capability bridge: the only component in the app that can read the
          screen and inject input. Deliberately not exported and protected by
          BIND_ACCESSIBILITY_SERVICE, so only the platform can bind it. The user
          still has to enable it by hand in Settings → Accessibility, and every
          capability behind it additionally needs the matching opt-in switch
          (docs/pi-android-app-design.md §21.4, §23.2).
        -->
        <!--
          `android:description` is deliberately absent: AAPT requires a
          @string/... reference there, and the user-visible wording already
          lives in res/xml/accessibility_service_config.xml, which is what the
          accessibility settings screen actually reads.
        -->
        <service
            android:name=".bridge.DeviceAccessibilityService"
            android:exported="false"
            android:label="PI 设备桥"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          输入法（「输入法」能力组，端点 `/app/ime/*`）。

          三处都必须有，少一处系统就不认这个组件：
            - `permission=BIND_INPUT_METHOD`：只有平台能绑定它，别的应用不能；
            - `android.view.InputMethod` 的 intent-filter：这是「一个输入法」的身份；
            - meta-data → `@xml/pi_input_method`：输入法自己的声明（最小，见那个文件）。

          `exported="true"` 不是放松：系统（另一个 uid 的 input method manager）必须能
          绑定它，而绑定被上面那条 BIND_INPUT_METHOD 权限挡着，普通应用绑不上。

          这个输入法的用途是让 pi 读得到/改得了用户正在输入的内容，不是给用户一个
          顺手键盘 —— 用户必须在系统里手动启用并切换过来，改不改由用户决定。
        -->
        <service
            android:name=".bridge.PiInputMethodService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/pi_input_method" />
        </service>

        <!--
          设备管理员接收器（「管理员」能力组，端点 `/app/admin/*`）。

          它只是**身份**：系统用它把「激活/停用」告诉本应用，能做的动作在
          `DeviceAdmin` 里（那才是被 `/app/admin/*` 调用的地方）。
          `BIND_DEVICE_ADMIN` 让只有系统能给它发广播；`android.app.device_admin`
          meta-data 指向的策略声明决定激活页面上问用户要什么（见那个文件，只有
          相机与锁屏两条，其余策略要在 Device Owner 身份下才有效、不需要 uses-policy）。

          激活/取消由用户在系统设置里操作，本应用不主动弹激活页。
        -->
        <receiver
            android:name=".bridge.PiDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/pi_device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          通知监听（并入「基础」能力组，端点 `/app/notify/*`）。

          它没有别的入口：系统只把通知内容交给自己绑定过的 listener，而绑定要求
          用户先在 系统设置 → 通知 → 通知使用权 里勾选本应用。`BIND_NOTIFICATION_LISTENER_SERVICE`
          保证只有系统能绑它。
        -->
        <service
            android:name=".bridge.PiNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          VPN（并入「基础」能力组，端点 `/app/vpn/*`）。

          非 root 设备上这是唯一能看到别人出站流量的入口（`VpnService` 把包交给本
          服务建的 TUN）。`BIND_VPN_SERVICE` 让只有系统能绑定；第一次启动前必须由
          用户在系统授权对话框里点同意（入口在能力页的「授权 VPN」按钮）。
        -->
        <service
            android:name=".bridge.PiVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
          投屏专用的前台服务（并入「基础」能力组，端点 `/app/capture/*`）。

          它不持有投影（那是 `PiScreenCapture` 的），只负责让平台的强制条件成立：
          「有一个 mediaProjection 类型的前台服务在跑」。**不能**把这个类型挂到
          `PiEngineService` 上：那个服务开机就起，而 Android 14 在没有投屏授权时
          用 mediaProjection 类型 `startForeground` 会抛异常 —— 等于让开机去撞一条
          必然失败的检查，把引擎一起打挂。所以这里单独一个服务，而且只在用户点完
          授权对话框之后才由能力页启动。

          `exported="false"`：只有本应用（一个已经在跑的前台 Activity）会启动它。
        -->
        <service
            android:name=".bridge.PiCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
